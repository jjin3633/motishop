# ── MotiShop API 환경변수 (프로덕션 EC2에서 .env 파일로 생성) ──

# 관리자 비밀번호 (hex 랜덤 추천: openssl rand -hex 16)
ADMIN_PW=change-me-strong-random-string

# InnoPay
# 테스트: arstest03m / 프로덕션: pgmotiph1m
INNOPAY_MID=arstest03m
INNOPAY_CHARGE_URL=https://api.innopay.co.kr/api/payAutoCardBill
INNOPAY_DELETE_BILLKEY_URL=https://api.innopay.co.kr/api/delAutoCardBill
INNOPAY_CANCEL_URL=https://api.innopay.co.kr/api/cancelApi
# 환불 비밀번호 — InnoPay 가맹점 등록 시 발급받은 cancelPwd
INNOPAY_CANCEL_PWD=

# CORS 허용 출처
CORS_ORIGIN=https://shop.motiphysio.com

# 결제 실패 알림용 Slack Incoming Webhook (옵션)
# 없으면 console 로그만 남김
SLACK_WEBHOOK_URL=

# DB 경로 (기본: ./motishop.db)
DB_PATH=./motishop.db

# 사전 안내 발송 여부 (미구현 시 false)
NOTIFY_ENABLED=false

# SOLAPI (SMS / 카카오 알림톡) — 솔라피 콘솔에서 IP 화이트리스트(54.180.132.84/32) + 발신번호 사전 등록 필수
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=07043657740

# DB S3 외부 백업 (옵션) — 빈 값이면 로컬 백업만
# 설정 시 backup.js가 매일 백업을 s3://<bucket>/motishop/ 경로에 업로드
# EC2에 IAM role(S3 PutObject) 또는 ~/.aws/credentials 필요. aws cli 설치 필요.
BACKUP_S3_BUCKET=

# GitHub Webhook 자동 배포 (POST /api/deploy/webhook)
# - GitHub Repo Settings → Webhooks → Secret 와 동일 값 사용
# - 빈 값이면 webhook 비활성화 (503 응답)
# 추천: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
DEPLOY_SCRIPT_PATH=/home/ec2-user/motishop-api/deploy.sh
